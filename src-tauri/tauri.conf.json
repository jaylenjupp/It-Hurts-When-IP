{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "It Hurts When IP",
  "version": "1.11.0",
  "identifier": "com.ithurtswhenip.desktop",
  "build": {
    "beforeDevCommand": "npx vite",
    "beforeBuildCommand": "npx vite build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "It Hurts When IP",
        "width": 480,
        "height": 580,
        "minWidth": 480,
        "minHeight": 580,
        "maxWidth": 800,
        "resizable": true,
        "fullscreen": false,
        "maximizable": false,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}