<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ithurtswhenip.helper</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/PrivilegedHelperTools/com.ithurtswhenip.helper</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- Umask 63 = octal 077: files the helper creates are owner-only by
         default, so the socket is never wider than 0660 between bind() and
         the helper's chown/chmod. Anything the helper creates later must set
         its mode explicitly. -->
    <key>Umask</key>
    <integer>63</integer>

    <key>StandardOutPath</key>
    <string>/var/log/com.ithurtswhenip.helper.log</string>

    <key>StandardErrorPath</key>
    <string>/var/log/com.ithurtswhenip.helper.error.log</string>
</dict>
</plist>