#!/usr/bin/env bash
# fake-networksetup — a stand-in for /usr/sbin/networksetup that never touches
# the real network. Used for dev (`IHWIP_NETWORKSETUP=...`) and tests.
#
# Runs on: anywhere (Mac Studio, Linux CI). Pure bash, no system changes.
#
# Reads come from a fixture set; writes update a private state copy so a
# following -getinfo reflects them, and every call is appended to a log so
# tests can assert exactly what would have been run.
#
# Environment:
#   IHWIP_FAKE_FIXTURES  fixture dir (default: <this dir>/fixtures/default)
#   IHWIP_FAKE_STATE     state dir   (default: ${TMPDIR:-/tmp}/ihwip-fake-networksetup)
#   IHWIP_FAKE_FAIL      comma list of subcommands to fail, e.g. "setmanual,setdhcp"
#   IHWIP_FAKE_RESET=1   wipe state and start again from fixtures
#
# Supported: -listallnetworkservices -listallhardwareports -listnetworkserviceorder
#            -getinfo -getdnsservers -getsearchdomains -setmanual -setdhcp
#            -setdnsservers -setsearchdomains -setnetworkserviceenabled
#            -version (and a "fake-log" helper subcommand)
# Output text mirrors real networksetup closely enough for parser tests.
# TODO(verify): exact wording/exit codes of real networksetup errors on the
# current macOS — capture real output into fixtures before relying on them.

set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FIXTURES="${IHWIP_FAKE_FIXTURES:-$HERE/fixtures/default}"
STATE="${IHWIP_FAKE_STATE:-${TMPDIR:-/tmp}/ihwip-fake-networksetup}"
LOG="$STATE/calls.log"

ERR_PARAMS="** Error: The parameters were not valid."

if [[ "${IHWIP_FAKE_RESET:-0}" == "1" ]]; then rm -rf "$STATE"; fi
if [[ ! -d "$STATE" ]]; then
    mkdir -p "$STATE/info" "$STATE/dns" "$STATE/search" || exit 1
    cp "$FIXTURES/services.txt" "$STATE/services.txt" 2>/dev/null || { echo "fake-networksetup: missing $FIXTURES/services.txt" >&2; exit 1; }
    cp "$FIXTURES/hardwareports.txt" "$STATE/hardwareports.txt" 2>/dev/null || true
    cp "$FIXTURES/info/"*.txt "$STATE/info/" 2>/dev/null || true
    : > "$LOG"
fi

# Log every call, quoted, one per line.
{ printf '%q ' "networksetup" "$@"; echo; } >> "$LOG"

sanitize() { printf '%s' "$1" | sed -E 's/[^A-Za-z0-9-]+/_/g'; }

service_exists() {
    # Matches enabled ("Name") and disabled ("*Name") services; skips header.
    tail -n +2 "$STATE/services.txt" | sed -E 's/^\*//' | grep -Fxq -- "$1"
}

should_fail() {
    local sub="$1"
    [[ ",${IHWIP_FAKE_FAIL:-}," == *",$sub,"* ]]
}

valid_ipv4() {
    local ip="$1" IFS=.
    # shellcheck disable=SC2206
    local -a o=($ip)
    [[ ${#o[@]} -eq 4 ]] || return 1
    for x in "${o[@]}"; do
        [[ "$x" =~ ^[0-9]{1,3}$ ]] && (( x <= 255 )) || return 1
    done
}

hw_addr_line() {
    local f
    f="$STATE/info/$(sanitize "$1").txt"
    grep -E '^(Ethernet Address|Wi-Fi ID):' "$f" 2>/dev/null | head -1 || echo "Ethernet Address: N/A"
}

cmd="${1:-}"; shift || true
sub="${cmd#-}"

if should_fail "$sub"; then
    # Real networksetup tends to print errors on stdout (cf. netsh); mimic that.
    echo "$ERR_PARAMS"
    exit 1
fi

case "$cmd" in
    -version)
        echo "networksetup (fake) for It Hurts When IP"
        ;;
    -listallnetworkservices)
        cat "$STATE/services.txt"
        ;;
    -listnetworkserviceorder)
        echo "An asterisk (*) denotes that a network service is disabled."
        n=1
        tail -n +2 "$STATE/services.txt" | while IFS= read -r line; do
            name="${line#\*}"
            echo "($n) $line"
            echo "(Hardware Port: $name, Device: fake$n)"
            echo
            n=$((n + 1))
        done
        ;;
    -listallhardwareports)
        cat "$STATE/hardwareports.txt"
        ;;
    -getinfo)
        svc="${1:-}"
        service_exists "$svc" || { echo "$ERR_PARAMS"; exit 1; }
        f="$STATE/info/$(sanitize "$svc").txt"
        if [[ -f "$f" ]]; then cat "$f"; else echo "DHCP Configuration"; fi
        ;;
    -getdnsservers)
        svc="${1:-}"
        service_exists "$svc" || { echo "$ERR_PARAMS"; exit 1; }
        f="$STATE/dns/$(sanitize "$svc").txt"
        if [[ -s "$f" ]]; then cat "$f"; else echo "There aren't any DNS Servers set on $svc."; fi
        ;;
    -getsearchdomains)
        svc="${1:-}"
        service_exists "$svc" || { echo "$ERR_PARAMS"; exit 1; }
        f="$STATE/search/$(sanitize "$svc").txt"
        if [[ -s "$f" ]]; then cat "$f"; else echo "There aren't any Search Domains set on $svc."; fi
        ;;
    -setmanual)
        svc="${1:-}"; ip="${2:-}"; mask="${3:-}"; router="${4:-}"
        service_exists "$svc" || { echo "$ERR_PARAMS"; exit 1; }
        if ! valid_ipv4 "$ip" || ! valid_ipv4 "$mask"; then echo "$ERR_PARAMS"; exit 1; fi
        if [[ -n "$router" ]]; then valid_ipv4 "$router" || { echo "$ERR_PARAMS"; exit 1; }; fi
        hw="$(hw_addr_line "$svc")"
        cat > "$STATE/info/$(sanitize "$svc").txt" <<EOF
Manual Configuration
IP address: $ip
Subnet mask: $mask
Router: $router
IPv6: Automatic
IPv6 IP address: none
IPv6 Router: none
$hw
EOF
        ;;
    -setdhcp)
        svc="${1:-}"
        service_exists "$svc" || { echo "$ERR_PARAMS"; exit 1; }
        hw="$(hw_addr_line "$svc")"
        orig="$FIXTURES/info/$(sanitize "$svc").txt"
        if [[ -f "$orig" ]] && head -1 "$orig" | grep -q '^DHCP'; then
            cp "$orig" "$STATE/info/$(sanitize "$svc").txt"
        else
            cat > "$STATE/info/$(sanitize "$svc").txt" <<EOF
DHCP Configuration
IP address: 169.254.99.99
Subnet mask: 255.255.0.0
Router:
Client ID:
IPv6: Automatic
IPv6 IP address: none
IPv6 Router: none
$hw
EOF
        fi
        ;;
    -setdnsservers|-setsearchdomains)
        svc="${1:-}"; shift || true
        service_exists "$svc" || { echo "$ERR_PARAMS"; exit 1; }
        dir="dns"; [[ "$cmd" == "-setsearchdomains" ]] && dir="search"
        f="$STATE/$dir/$(sanitize "$svc").txt"
        if [[ "${1:-}" == "Empty" || $# -eq 0 ]]; then : > "$f"; else printf '%s\n' "$@" > "$f"; fi
        ;;
    -setnetworkserviceenabled)
        svc="${1:-}"; state="${2:-}"
        service_exists "$svc" || { echo "$ERR_PARAMS"; exit 1; }
        tmp="$(mktemp)"
        { head -1 "$STATE/services.txt"
          tail -n +2 "$STATE/services.txt" | while IFS= read -r line; do
              name="${line#\*}"
              if [[ "$name" == "$svc" ]]; then
                  if [[ "$state" == "off" ]]; then echo "*$name"; else echo "$name"; fi
              else
                  echo "$line"
              fi
          done; } > "$tmp" && mv "$tmp" "$STATE/services.txt"
        ;;
    fake-log)
        cat "$LOG"
        ;;
    "")
        echo "Usage: networksetup -<command> [args] (fake)"; exit 1
        ;;
    *)
        echo "fake-networksetup: unsupported command '$cmd' (add it if the app needs it)" >&2
        exit 2
        ;;
esac
exit 0
